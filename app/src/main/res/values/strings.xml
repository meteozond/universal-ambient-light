  <string name="pref_title_adb_port">ADB Port</string>
  <string name="pref_btn_adb_pair">Test ADB Connection</string>
  <string name="pref_summary_adb_pair">Check connection and authorize the key on the TV</string>
  <string name="adb_pair_title">ADB Authorization</string>
  <string name="adb_pair_instruction">On first connection the TV will show an "Allow wireless debugging?" dialog — tap Allow on the TV screen. Make sure Wireless Debugging is enabled in Developer Options.</string>
  <string name="error_adb_pairing_required">ADB pairing required. Open Settings → Capture method → Test ADB Connection → Pair with code.</string>
  <string name="adb_pair_code_title">Pair with code (Android 11+, one-time)</string>
  <string name="adb_pair_code_hint">6-digit pairing code</string>
  <string name="adb_pair_port_hint">Pairing port (from that screen)</string>
  <string name="adb_pair_code_instruction">Manual fallback: open Wireless debugging → "Pair device with pairing code" and type the PORT and 6-digit CODE shown there. The automatic button above is easier — it reads the code itself and pairs without leaving that screen.</string>
  <string name="adb_autopair_btn">Pair automatically (Accessibility)</string>
  <string name="adb_autopair_waiting">Enable Wireless debugging if needed — the app will open it, then read the code and pair by itself.</string>
  <string name="adb_autopair_need_accessibility">Turn on Accessibility for this app on the next screen, then tap "Pair automatically" again.</string>
  <string name="adb_enable_accessibility_toast">Find "%1$s" in the list, open it and turn it ON — then go back and tap "Pair automatically".</string>
  <string name="adb_autopair_consent_title">Automatic pairing — please confirm</string>
  <string name="adb_autopair_consent_text">To capture the screen, the app connects to this device\'s own ADB over localhost (127.0.0.1). With your permission it will: open Wireless debugging, read the one-time 6-digit pairing code shown on that screen using the Accessibility service, and tap the “Pair device with pairing code” option for you. It connects only locally, does not change any other settings, and sends nothing off the device. Continue?</string>
  <string name="adb_autopair_consent_continue">Continue</string>
  <string name="adb_autopair_timeout">Timed out. Make sure Wireless debugging is ON, then tap "Pair automatically" again.</string>
  <string name="adb_pair_manual_label">Enter manually</string>
